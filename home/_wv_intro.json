{"intro": "<div class=\"wv-intro\" aria-hidden=\"true\">\n    <video class=\"wv-intro-v\" data-pc=\"/home/video/widy-intro.mp4\" data-movil=\"/home/video/widy-intro-movil.mp4\" muted playsinline autoplay preload=\"auto\"></video>\n  </div>\n  <style>\n  .wv-intro{display:none}\n  .wv-on .wv-intro{position:fixed;inset:0;z-index:5000;display:block;background:#071230;transition:opacity .7s cubic-bezier(.65,0,.35,1),transform .9s cubic-bezier(.65,0,.35,1)}\n  .wv-intro.out{opacity:0;transform:scale(1.06);pointer-events:none}\n  .wv-intro-v{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n  .wv-on body{overflow:hidden}\n  .tp-hero-bg .wv-bgv{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}\n  .tp-hero-bg .wv-bgv-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,10,28,.92) 0%,rgba(4,10,28,.7) 45%,rgba(4,10,28,.25) 100%),linear-gradient(0deg,rgba(4,10,28,.9),transparent 35%)}\n  @media(max-width:899px){.tp-hero-bg .wv-bgv{opacity:.35}.tp-hero-bg .wv-bgv-shade{background:linear-gradient(0deg,rgba(4,10,28,.85),rgba(4,10,28,.55))}}\n  @media(prefers-reduced-motion:reduce){.wv-intro{display:none!important}.tp-hero-bg .wv-bgv{display:none}}\n  </style>\n  <script>\n  (function(){var d=document.documentElement;try{if(new URLSearchParams(location.search).has(\"intro\"))sessionStorage.removeItem(\"wvIntro\");if(sessionStorage.getItem(\"wvIntro\")||matchMedia(\"(prefers-reduced-motion: reduce)\").matches)return;sessionStorage.setItem(\"wvIntro\",\"1\")}catch(e){}\n  d.classList.add(\"wv-on\");\n  document.addEventListener(\"DOMContentLoaded\",function(){var el=document.querySelector(\".wv-intro\"),v=el.querySelector(\"video\"),hecho=false;\n   function fin(){if(hecho)return;hecho=true;el.classList.add(\"out\");setTimeout(function(){d.classList.remove(\"wv-on\")},750)}\n   el.addEventListener(\"click\",fin);\n   \n   v.addEventListener(\"ended\",function(){setTimeout(fin,250)});\n   var empezo=false;v.addEventListener(\"playing\",function(){empezo=true});v.addEventListener(\"waiting\",function(){if(empezo)fin()});setTimeout(function(){if(!empezo)fin()},1000);/* si no arranca en 1 s o se para a cargar, entra directo */setTimeout(fin,8000);\n   var p=v.play();if(p&&p.catch)p.catch(fin)})})();\n  </script>", "bg": "<div class=\"tp-hero-bg\" aria-hidden=\"true\"><video class=\"wv-bgv\" data-pc=\"/home/video/widy-cintas.mp4\" data-movil=\"/home/video/widy-cintas-movil.mp4\" data-poster-pc=\"/home/video/widy-cintas.jpg\" data-poster-movil=\"/home/video/widy-cintas-movil.jpg\" muted playsinline autoplay loop preload=\"metadata\"></video><div class=\"wv-bgv-shade\"></div></div>", "sel": "<script>(function(){var m=matchMedia(\"(max-aspect-ratio: 1/1)\").matches;document.querySelectorAll(\"video[data-pc]\").forEach(function(v){var pp=v.getAttribute(m?\"data-poster-movil\":\"data-poster-pc\");if(pp)v.poster=pp;v.src=v.getAttribute(m?\"data-movil\":\"data-pc\");v.load();var p=v.play();if(p&&p.catch)p.catch(function(){})})})();</script>"}